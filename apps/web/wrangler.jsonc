// The hosted HexSketch: the static build in ./dist, plus worker.ts for /api/*
// (File > Send Feedback, stored in the KV namespace "hexsketch-feedback").
// _headers in public/ (copied into dist) sets the security headers.
// Deploy from the repo root: npm run deploy:web
{
  "name": "hexsketch",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // www.hexsketch.com and the old drawchem address forward here (tools/redirect).
  "routes": [{ "pattern": "hexsketch.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the script; everything else is served as static files.
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "FEEDBACK", "id": "aad0cae2ecc041dcb1b07c8e56c97f7f" }],
  "ratelimits": [{ "name": "FEEDBACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
