{
  "name": "hexsketch",
  "private": true,
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "description": "Chemical structure editor for the browser",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types packages/*/test/*.test.ts tools/llm-bench/test/*.test.ts",
    "dev": "npm run dev -w @hexsketch/web",
    "build:web": "npm run build -w @hexsketch/web",
    "build:pkg": "npm run build -w hexsketch",
    "build:mcpb": "npm run build:mcpb -w hexsketch",
    "serve:web": "node --experimental-strip-types tools/serve-dist.ts apps/web/dist 5180",
    "deploy:web": "npm run build:web && cd apps/web && npx --yes wrangler@4 deploy",
    "dev:mcp": "npm run dev -w @hexsketch/mcp-worker",
    "deploy:mcp": "npm run build -w @hexsketch/mcp-app && cd apps/mcp-worker && npx --yes wrangler@4 deploy",
    "deploy:mcp:staging": "npm run build -w @hexsketch/mcp-app && cd apps/mcp-worker && npx --yes wrangler@4 deploy --env staging",
    "smoke:mcp": "node --experimental-strip-types --no-warnings apps/mcp-worker/test/smoke.ts",
    "feedback": "node --experimental-strip-types --no-warnings tools/feedback.ts",
    "usage": "node --experimental-strip-types --no-warnings tools/usage.ts",
    "bench": "sh tools/bench/run.sh",
    "llm-bench": "node --experimental-strip-types --no-warnings tools/llm-bench/run.ts",
    "llm-bench:prep": "node --experimental-strip-types --no-warnings tools/llm-bench/prep.ts",
    "llm-bench:plot": "node --experimental-strip-types --no-warnings tools/llm-bench/plot.ts",
    "llm-bench:compare": "node --experimental-strip-types --no-warnings tools/llm-bench/compare.ts",
    "llm-bench:items": "node --experimental-strip-types --no-warnings tools/llm-bench/items.ts",
    "llm-bench:layout": "node --experimental-strip-types --no-warnings tools/llm-bench/layout.ts",
    "llm-bench:grading": "node --experimental-strip-types --no-warnings tools/llm-bench/grading.ts",
    "llm-bench:sheet": "node --experimental-strip-types --no-warnings tools/llm-bench/sheet.ts",
    "llm-bench:sat": "node --experimental-strip-types --no-warnings tools/llm-bench/sat.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3"
  }
}
